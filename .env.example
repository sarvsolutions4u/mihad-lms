# Copy this file to .env.local and fill in the real values.

# MongoDB Atlas connection string — note the database name mihad_lms before the ?
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mihad_lms?retryWrites=true&w=majority

# Long random string used to sign login sessions:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-this-to-a-long-random-string

# Optional — first admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@almihadtraining.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator

# Optional — Cloudinary, only if you want the app to host uploaded files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
